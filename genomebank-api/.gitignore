target/
build/
out/
dependency-reduced-pom.xml

# Ignorar archivos de Maven Wrapper binarios
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# No ignorar los target de los recursos principales
!**/src/main/**/target/
!**/src/test/**/target/

